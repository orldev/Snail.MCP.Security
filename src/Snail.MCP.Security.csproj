<Project Sdk="Microsoft.NET.Sdk.Web">

  <Sdk Name="Snail.Sdk.Mcp" />

  <!--
    Native and HTTP only (Snail.Sdk.Mcp): the server runs in its own container on the stand, beside the Nomad agent it
    runs the scanners through, and answers the workers of the platform at its port. Native, it is ready in half the time
    and holds 36 MB at rest instead of 91 (measured 2026-10-30 on Apple Silicon).
  -->
  <PropertyGroup>
    <SnailMcpNative>true</SnailMcpNative>
    <SnailMcpTransport>Http</SnailMcpTransport>
    <SnailMcpContainer>true</SnailMcpContainer>
    <Version>0.2.0</Version>
    <Description>Security checks of a working copy and of a proven site, mapped to ENS and NIS2</Description>
    <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;security;nomad;nmap;nuclei;ens;nis2</PackageTags>
    <RepositoryUrl>https://github.com/orldev/Snail.MCP.Security</RepositoryUrl>
    <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Security</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Snail.Toolkit.Nomad" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snail.MCP.Security.Tests" />
    <InternalsVisibleTo Include="Snail.MCP.Security.Benchmarks" />
  </ItemGroup>

</Project>
